# Copy this file to .env and fill in the values. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Internal Integration Secret from notion.so/my-integrations
NOTION_TOKEN=

# Notion API version (leave as is)
NOTION_VERSION=2026-03-11

# OpenAI-compatible endpoint, WITHOUT /chat/completions at the end
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Optional: your Telegram chat_id to receive error alerts
OWNER_CHAT_ID=
